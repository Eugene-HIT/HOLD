page {
  background: #f6f2e8;
  color: #1b2419;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* ---------- 基础容器 ---------- */

.app-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

/* tabBar 页面需要额外留出底部安全距离 */
.app-page--tabbed {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */

.app-card {
  background: #fffdf7;
  border: 1rpx solid rgba(27, 36, 25, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 36, 25, 0.03);
}

.app-card--flush {
  padding: 0;
  overflow: hidden;
}

/* ---------- 文本层级 ---------- */

.app-eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #9a9a8e;
  text-transform: uppercase;
}

.app-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b2419;
  letter-spacing: 1rpx;
}

.app-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1b2419;
  letter-spacing: 1rpx;
}

.app-body {
  font-size: 27rpx;
  color: #5d6558;
  line-height: 1.7;
}

.app-muted {
  font-size: 24rpx;
  color: #9a9a8e;
  line-height: 1.6;
}

.app-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #a8a89c;
}

/* ---------- 卡片头 ---------- */

.app-card-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.app-card-head__link {
  font-size: 25rpx;
  color: #2f5d3a;
}

/* ---------- 按钮 ---------- */

.app-button {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 500;
  text-align: center;
  padding: 0;
}

.app-button--primary {
  background: #2f5d3a;
  color: #fffdf7;
}

.app-button--primary.button-hover {
  background: #26492e;
}

.app-button--outline {
  background: transparent;
  color: #2f5d3a;
  border: 1rpx solid rgba(47, 93, 58, 0.35);
}

.app-button--ghost {
  background: rgba(27, 36, 25, 0.04);
  color: #5d6558;
}

.app-button--danger {
  background: transparent;
  color: #a4442c;
  border: 1rpx solid rgba(164, 68, 44, 0.3);
}

.app-button[disabled] {
  opacity: 0.45;
}

/* ---------- 数值展示 ---------- */

.app-metric-value {
  font-size: 56rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.app-metric-unit {
  font-size: 22rpx;
  color: #9a9a8e;
  margin-left: 6rpx;
}

.app-metric-label {
  font-size: 24rpx;
  color: #7d8578;
  margin-top: 4rpx;
}

/* ---------- 状态点 ---------- */

.app-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c3c3b6;
  flex: none;
}

.app-dot--live {
  background: #3e7c59;
}

.app-dot--busy {
  background: #c98a2e;
}

.app-dot--off {
  background: #c3c3b6;
}
