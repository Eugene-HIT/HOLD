.history-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
}

.page-topbar {
  padding: 12rpx 4rpx 28rpx;
}

.page-topbar .app-title {
  display: block;
  margin-bottom: 8rpx;
}

/* ---------- 分段切换 ---------- */

.seg {
  display: flex;
  background: rgba(27, 36, 25, 0.05);
  border-radius: 999rpx;
  padding: 6rpx;
  margin: 0 0 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #7d8578;
  padding: 14rpx 0;
  border-radius: 999rpx;
}

.seg-item--on {
  background: #fffdf7;
  color: #1b2419;
  font-weight: 500;
}

/* ---------- 每日分析卡片 ---------- */

.daily-card:active {
  background: #f9f5ea;
}

.daily-metrics {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
}

.daily-metric {
  flex: 1;
  text-align: center;
}

.daily-metric-value {
  font-size: 40rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.2;
}

.daily-metric .app-metric-label {
  font-size: 21rpx;
}

.record-card {
  padding: 30rpx 28rpx;
}

.record-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.record-tag {
  font-size: 24rpx;
  color: #2f5d3a;
  background: rgba(47, 93, 58, 0.09);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.record-title {
  font-size: 31rpx;
  font-weight: 500;
  color: #1b2419;
  margin-bottom: 10rpx;
}

.record-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 8rpx;
}

.record-metric {
  width: calc(50% - 8rpx);
  background: #f6f2e8;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
}

.record-metric-value {
  font-size: 38rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.2;
}

.record-meta {
  margin-top: 8rpx;
}

.history-copy {
  font-size: 26rpx;
  color: #5d6558;
  line-height: 1.7;
  margin-top: 18rpx;
}

.record-foot {
  display: block;
  margin-top: 10rpx;
}

.record-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.record-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 27rpx;
}
