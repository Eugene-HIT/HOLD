<view class="report-page">
  <view class="report-hero">
    <view class="report-tag">{{viewReport.resultTag}}</view>
    <view class="report-title">{{viewReport.title}}</view>
    <view class="report-subtitle">{{viewReport.startedAt}}{{viewReport.durationLabel ? ' · ' + viewReport.durationLabel : ''}}</view>
    <view class="report-meta">前端构建 {{pageBuildTag}}</view>
  </view>

  <view class="report-panel">
    <view class="panel-title">指部 PPG 曲线与跳点</view>
    <view class="chart-meta">最近 1 分钟缓存 · 心率 {{viewReport.metrics && viewReport.metrics[0] ? viewReport.metrics[0].value : '--'}} bpm</view>
    <view class="chart-meta">{{chartStatusText}}</view>
    <canvas canvas-id="chestPpgCanvas" class="wave-canvas" style="width: {{chartWidth}}px; height: {{chartHeight}}px;" width="{{chartWidth}}" height="{{chartHeight}}"></canvas>
  </view>

  <view class="report-panel metrics-panel">
    <view class="panel-title">关键参数</view>
    <view class="metrics-row">
      <block wx:for="{{viewReport.metrics}}" wx:key="label">
        <view class="report-metric">
          <view class="report-metric-value">{{item.value}}{{item.unit}}</view>
          <view class="report-metric-label">{{item.label}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="report-panel">
    <view class="panel-title">报告摘要</view>
    <view class="section-text">{{viewReport.summary}}</view>
  </view>

  <view class="report-panel">
    <view class="panel-title">简要分析与建议</view>
    <view class="section-text">{{viewReport.briefAnalysis}}</view>
    <view class="section-text">{{viewReport.briefAdvice}}</view>
  </view>

  <view class="report-panel">
    <view class="panel-title">模型分析结果</view>
    <view class="section-text" wx:if="{{canGenerateReport}}">点击下面按钮后，会把这次已经完整缓存下来的 1 分钟主动检测数据发送给模型，生成这次指部 PPG 报告。</view>
    <view class="section-text" wx:elif="{{hasStoredReport}}">当前已经有主动检测记录，但这条记录还没满足完整生成条件，因此这里先显示缓存曲线与参数。</view>
    <view class="section-text" wx:else>当前还没有可生成报告的主动检测记录，因此这里暂时只显示曲线预览，不显示正式模型分析。</view>
    <button class="report-button" bindtap="generateReport" loading="{{reportStatus === 'running'}}">生成这次报告</button>
    <view class="report-meta" wx:if="{{reportFeedback}}">{{reportFeedback}}</view>
    <view class="report-meta" wx:if="{{runtimeDebugInfo}}">调试 {{runtimeDebugInfo}}</view>
    <view class="report-meta" wx:if="{{!canGenerateReport}}">当前按钮已显示，但只有在这次 60 秒检测完整缓存后，才会真正把这一条检测数据送给模型。</view>
    <view class="report-meta" wx:if="{{viewReport.generatedReportUpdatedAt}}">最近生成 {{viewReport.generatedReportUpdatedAt}}</view>
    <view class="report-meta" wx:if="{{viewReport.generatedReportSource}}">来源 {{viewReport.generatedReportSource}}</view>
    <view class="report-error" wx:if="{{viewReport.generatedReportError}}">错误 {{viewReport.generatedReportError}}</view>
    <view class="section-text" wx:if="{{viewReport.generatedReportText}}">{{viewReport.generatedReportText}}</view>
  </view>

  <view class="report-panel" wx:if="{{viewReport.reportSections && viewReport.reportSections.length}}">
    <view class="panel-title">详细板块</view>
    <block wx:for="{{viewReport.reportSections}}" wx:key="heading">
      <view class="section-block">
        <view class="section-heading">{{item.heading}}</view>
        <view class="section-text">{{item.body}}</view>
      </view>
    </block>
  </view>

  <view class="report-panel">
    <view class="panel-title">记录详情</view>
    <view class="section-text">处理点数 {{viewReport.processedPointCount || 0}}</view>
    <view class="section-text">完整前端缓存点数 {{viewReport.fullProcessedPointCount || 0}} / beat {{viewReport.fullBeatCount || 0}}</view>
    <view class="section-text" wx:if="{{viewReport.archiveMode}}">记录来源 {{viewReport.archiveMode}}</view>
    <view class="section-text" wx:if="{{viewReport.receivedFragmentCount || viewReport.fragmentTotal}}">窗口分片 {{viewReport.receivedFragmentCount || 0}} / {{viewReport.fragmentTotal || 0}}</view>
  </view>
</view>