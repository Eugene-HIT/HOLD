.report-page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #f6efe4 0%, #ede2d0 100%);
}

.report-hero,
.report-panel {
  border-radius: 28rpx;
  background: rgba(255, 252, 247, 0.95);
  box-shadow: 0 18rpx 46rpx rgba(50, 52, 35, 0.08);
}

.report-hero {
  padding: 30rpx;
  background: linear-gradient(135deg, #294235 0%, #345747 100%);
  color: #fbf5e8;
}

.report-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(251, 245, 232, 0.14);
  font-size: 22rpx;
  font-weight: 700;
}

.report-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.report-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(251, 245, 232, 0.84);
}

.report-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}

.wave-canvas {
  margin-top: 18rpx;
  width: 100%;
  border-radius: 20rpx;
  background: #f8f3e7;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #20372a;
}

.metrics-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.report-metric {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f1ead8;
}

.report-metric-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #20372a;
}

.report-metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6a7368;
}

.section-block {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(32, 55, 42, 0.08);
}

.section-block:first-of-type {
  border-top: none;
  padding-top: 0;
}

.section-heading {
  font-size: 26rpx;
  font-weight: 700;
  color: #2d4236;
}

.section-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #51604f;
}

.report-button {
  margin-top: 18rpx;
  border-radius: 20rpx;
  background: #20372a;
  color: #f7f2e5;
  font-size: 24rpx;
}

.report-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6a7368;
}

.chart-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6a7368;
}

.report-error {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b15435;
}