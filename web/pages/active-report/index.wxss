.report-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

.report-hero {
  padding: 12rpx 4rpx 32rpx;
}

.report-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #2f5d3a;
  background: rgba(47, 93, 58, 0.09);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

.report-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1b2419;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.section-gap {
  display: block;
  margin-bottom: 18rpx;
}

.chart-caption {
  display: block;
  margin-bottom: 16rpx;
}

.wave-canvas {
  width: 100%;
  border-radius: 16rpx;
  background: #fffdf7;
  border: 1rpx solid rgba(27, 36, 25, 0.06);
}

.metrics-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.report-metric {
  width: calc(50% - 8rpx);
  background: #f6f2e8;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
}

.report-metric-value {
  font-size: 40rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.2;
}

.second-line {
  margin-top: 16rpx;
}

.report-button {
  margin-top: 28rpx;
}

.report-feedback {
  display: block;
  margin-top: 16rpx;
}

.report-error {
  font-size: 24rpx;
  color: #a4442c;
  margin-top: 12rpx;
}

.report-text {
  white-space: pre-wrap;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(27, 36, 25, 0.06);
}

.section-block {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(27, 36, 25, 0.05);
}

.section-block:first-child {
  border-top: none;
  padding-top: 0;
}

.section-heading {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b2419;
  margin-bottom: 8rpx;
}
