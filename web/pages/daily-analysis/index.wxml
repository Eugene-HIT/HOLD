<view class="daily-page">
  <view class="page-topbar">
    <view class="app-title">每日分析</view>
    <view class="app-muted">按天查看已归档的呼吸与心率摘要。</view>
  </view>

  <block wx:if="{{activeDay}}">
    <scroll-view class="day-tabs" scroll-x="true" enable-flex="true">
      <block wx:for="{{dailyAnalyses}}" wx:for-item="day" wx:key="day">
        <view class="day-tab {{index === activeIndex ? 'active' : ''}}" bindtap="switchDay" data-index="{{index}}">
          <view class="day-tab-date">{{day.day}}</view>
          <view class="day-tab-label">{{day.title}}</view>
        </view>
      </block>
    </scroll-view>

    <view class="app-card">
      <view class="stats-grid">
        <view class="stat-item">
          <view class="stat-value">{{activeDay.respirationAvg || '--'}}</view>
          <view class="app-metric-label">平均呼吸（次/分）</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{activeDay.heartRateAvg || '--'}}</view>
          <view class="app-metric-label">平均心率（bpm）</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{activeDay.windowCount || '--'}}</view>
          <view class="app-metric-label">监测窗口（个）</view>
        </view>
      </view>
    </view>

    <view class="app-card">
      <view class="app-section-title section-gap">当日观察</view>
      <view class="app-body" wx:if="{{activeDay.insight}}">{{activeDay.insight}}</view>
      <view class="app-body second-line" wx:if="{{activeDay.summary}}">{{activeDay.summary}}</view>
      <view class="app-body second-line" wx:if="{{activeDay.suggestion}}">{{activeDay.suggestion}}</view>
    </view>

    <view class="app-card">
      <view class="app-section-title section-gap">呼吸曲线</view>
      <view class="app-muted chart-caption">平均呼吸 {{activeDay.respirationAvg || '--'}} 次/分</view>
      <canvas canvas-id="respWaveCanvas" class="wave-canvas" style="width: {{chartWidth}}px; height: {{chartHeight}}px;" width="{{chartWidth}}" height="{{chartHeight}}"></canvas>
    </view>

    <view class="app-card">
      <view class="app-section-title section-gap">胸口 PPG 曲线</view>
      <view class="app-muted chart-caption">平均心率 {{activeDay.heartRateAvg || '--'}} bpm</view>
      <canvas canvas-id="chestPpgCanvas" class="wave-canvas" style="width: {{chartWidth}}px; height: {{chartHeight}}px;" width="{{chartWidth}}" height="{{chartHeight}}"></canvas>
    </view>

    <view class="app-card" wx:if="{{activeDay.timeline && activeDay.timeline.length}}">
      <view class="app-section-title section-gap">时段记录</view>
      <view class="timeline-list">
        <block wx:for="{{activeDay.timeline}}" wx:for-item="slot" wx:key="time">
          <view class="timeline-row">
            <view class="timeline-time">{{slot.time}}</view>
            <view class="timeline-dot {{slot.level}}"></view>
            <view class="timeline-text">{{slot.label}} · {{slot.value}}</view>
          </view>
        </block>
      </view>
    </view>

    <view class="app-card">
      <view class="app-section-title section-gap">智能分析</view>
      <view class="app-body">把当天的呼吸曲线、PPG 曲线与统计数据发送给模型，生成当天简要分析。</view>
      <button class="app-button app-button--primary report-button" bindtap="generateReport" loading="{{reportStatus === 'running'}}">
        {{reportStatus === 'running' ? '生成中' : '生成当日分析'}}
      </button>
      <view class="app-muted" wx:if="{{reportUpdatedAt}}">生成于 {{reportUpdatedAt}}</view>
      <view class="report-error" wx:if="{{reportError}}">生成失败：{{reportError}}</view>
      <view class="app-body report-text" wx:if="{{reportText}}">{{reportText}}</view>
    </view>
  </block>

  <view class="app-card" wx:else>
    <view class="app-empty">暂无按日归档的监测数据。设备上报后会自动按天整理。</view>
  </view>
</view>
