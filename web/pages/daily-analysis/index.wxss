.daily-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
}

.page-topbar {
  padding: 12rpx 4rpx 28rpx;
}

.page-topbar .app-title {
  display: block;
  margin-bottom: 8rpx;
}

.day-tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.day-tab {
  display: inline-block;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: #fffdf7;
  border: 1rpx solid rgba(27, 36, 25, 0.06);
  vertical-align: top;
}

.day-tab.active {
  background: #2f5d3a;
  border-color: #2f5d3a;
}

.day-tab-date {
  font-size: 28rpx;
  color: #1b2419;
  line-height: 1.3;
}

.day-tab-label {
  font-size: 22rpx;
  color: #9a9a8e;
  line-height: 1.3;
}

.day-tab.active .day-tab-date,
.day-tab.active .day-tab-label {
  color: #fffdf7;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 46rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.2;
}

.stat-item .app-metric-label {
  font-size: 21rpx;
}

.section-gap {
  display: block;
  margin-bottom: 18rpx;
}

.second-line {
  margin-top: 16rpx;
}

.chart-caption {
  display: block;
  margin-bottom: 16rpx;
}

.wave-canvas {
  width: 100%;
  border-radius: 16rpx;
  background: #fffdf7;
  border: 1rpx solid rgba(27, 36, 25, 0.06);
}

.timeline-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(27, 36, 25, 0.05);
}

.timeline-row:first-child {
  border-top: none;
}

.timeline-time {
  font-size: 25rpx;
  color: #7d8578;
  width: 130rpx;
  flex: none;
}

.timeline-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c3c3b6;
  margin-right: 16rpx;
  flex: none;
}

.timeline-dot.good,
.timeline-dot.stable {
  background: #3e7c59;
}

.timeline-dot.warn,
.timeline-dot.medium {
  background: #c98a2e;
}

.timeline-dot.bad,
.timeline-dot.high {
  background: #b4472f;
}

.timeline-text {
  font-size: 26rpx;
  color: #5d6558;
  flex: 1;
}

.report-button {
  margin: 24rpx 0 16rpx;
}

.report-error {
  font-size: 24rpx;
  color: #a4442c;
  margin-top: 12rpx;
}

.report-text {
  white-space: pre-wrap;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(27, 36, 25, 0.06);
}
