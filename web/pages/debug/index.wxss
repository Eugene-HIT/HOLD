.debug-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
}

.debug-hero {
  background: #efe7d6;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hero-back {
  font-size: 25rpx;
  color: #2f5d3a;
  padding: 6rpx 20rpx;
  border: 1rpx solid rgba(47, 93, 58, 0.3);
  border-radius: 999rpx;
}

.debug-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-gap {
  margin-bottom: 20rpx;
  display: block;
}

.state-dot-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(27, 36, 25, 0.05);
}

.status-row:last-child {
  border-bottom: none;
}

.status-row .label {
  font-size: 26rpx;
  color: #7d8578;
  flex: none;
  width: 200rpx;
}

.status-row .value {
  font-size: 26rpx;
  color: #1b2419;
  text-align: right;
  word-break: break-all;
  flex: 1;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric-card {
  width: calc(33.33% - 11rpx);
  background: #f6f2e8;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.2;
}

.metric-value.small {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: center;
}

.metric-label {
  font-size: 21rpx;
  color: #9a9a8e;
  margin-top: 6rpx;
  text-align: center;
}

.chart-caption {
  margin-bottom: 16rpx;
  display: block;
}

.wave-canvas {
  width: 100%;
  border-radius: 16rpx;
  background: #fffdf7;
  border: 1rpx solid rgba(27, 36, 25, 0.06);
}

.head-tools {
  display: flex;
  gap: 24rpx;
}

.tool {
  font-size: 25rpx;
  color: #2f5d3a;
}

.log-list {
  background: #1b2419;
  border-radius: 16rpx;
  padding: 20rpx;
}

.log-item {
  font-size: 22rpx;
  line-height: 1.7;
  color: #d8d8c8;
  font-family: "SFMono-Regular", Consolas, monospace;
  word-break: break-all;
}

.raw-block {
  margin-top: 16rpx;
  background: #1b2419;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #d8d8c8;
  font-family: "SFMono-Regular", Consolas, monospace;
  word-break: break-all;
  max-height: 320rpx;
  overflow: hidden;
}

.debug-tip .app-body {
  font-size: 25rpx;
}
