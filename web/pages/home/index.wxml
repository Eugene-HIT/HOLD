<view class="home-page">
  <view class="home-topbar">
    <view>
      <view class="brand">HOLD</view>
      <view class="app-muted brand-sub">呼吸与心率监测</view>
    </view>
    <view class="debug-entry" bindtap="openDebugPage">调试</view>
  </view>

  <view class="app-card device-card">
    <view class="device-row">
      <view class="app-dot {{isConnected ? 'app-dot--live' : (connecting ? 'app-dot--busy' : 'app-dot--off')}}"></view>
      <view class="device-text">
        <view class="device-name">{{connectionText}}</view>
        <view class="app-muted">{{connectionHint}}</view>
      </view>
      <button class="connect-btn" wx:if="{{!isConnected}}" bindtap="connectDevice" loading="{{connecting}}">{{connecting ? '搜索中' : '连接'}}</button>
    </view>
  </view>



  <view class="app-card">
    <view class="app-card-head">
      <view class="app-section-title">实时</view>
      <text class="app-muted" wx:if="{{liveUpdatedAt}}">{{liveUpdatedAt}}</text>
    </view>

    <view class="live-grid">
      <view class="live-item">
        <view class="live-value">{{respBpm}}<text class="live-unit">次/分</text></view>
        <view class="app-metric-label">呼吸</view>
      </view>
      <view class="live-divider"></view>
      <view class="live-item">
        <view class="live-value">{{heartBpm}}<text class="live-unit">bpm</text></view>
        <view class="app-metric-label">心率</view>
      </view>
    </view>

    <view class="wave-wrap">
      <view class="wave-block">
        <view class="wave-label">
          <view class="wave-dot wave-dot--resp"></view>
          <text class="app-muted">呼吸波形</text>
        </view>
        <canvas canvas-id="homeRespCanvas" class="home-wave" style="width: {{chartWidth}}px; height: {{chartHeight}}px;" width="{{chartWidth}}" height="{{chartHeight}}"></canvas>
      </view>
      <view class="wave-block">
        <view class="wave-label">
          <view class="wave-dot wave-dot--heart"></view>
          <text class="app-muted">心率波形 · 胸口 PPG</text>
        </view>
        <canvas canvas-id="homeHeartCanvas" class="home-wave" style="width: {{chartWidth}}px; height: {{chartHeight}}px;" width="{{chartWidth}}" height="{{chartHeight}}"></canvas>
      </view>
    </view>
  </view>

  <view class="app-card guide-card" wx:if="{{hasGuide}}">
    <view class="app-eyebrow">请跟随提示</view>
    <view class="guide-text">{{guideText}}</view>
    <view class="app-muted" wx:if="{{guideMeta}}">{{guideMeta}}</view>
  </view>

  <view class="app-card action-card">
    <view class="app-section-title">呼吸引导</view>
    <view class="app-body">跟随设备提示完成一次呼吸训练，全程约 1 分钟。过程中请保持身体放松、匀速呼吸。</view>
    <button class="app-button app-button--primary action-button" bindtap="startBreathGuide" loading="{{breathGuideRunning}}">
      {{breathGuideRunning ? '引导进行中' : '开始呼吸引导'}}
    </button>
    <view class="app-muted action-hint" wx:if="{{!isConnected}}">需先连接设备后开始。</view>
  </view>

  <view class="app-card">
    <view class="app-card-head">
      <view class="app-section-title">指部 PPG 主动检测</view>
      <text class="app-card-head__link" wx:if="{{!activeTestRunning && hasLatestReport}}" bindtap="openLatestReport">查看报告</text>
    </view>

    <block wx:if="{{activeTestRunning}}">
      <view class="progress-row">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{activeTestPercent}}%"></view>
        </view>
        <view class="app-muted progress-text">{{activeTestElapsed}} / {{activeTestTarget}} 秒</view>
      </view>

      <view class="active-live">
        <view class="active-live-item">
          <view class="active-live-value">{{activeTestHeart}}<text class="live-unit">bpm</text></view>
          <view class="app-metric-label">实时心率</view>
        </view>
        <view class="active-live-item">
          <view class="active-live-value">{{activeTestBeats}}</view>
          <view class="app-metric-label">已检出 beat</view>
        </view>
      </view>

      <view class="app-muted">请保持手指贴合传感器、身体尽量静止，检测结束后会自动生成报告。</view>
    </block>

    <block wx:else>
      <view class="app-body">60 秒指部 PPG 检测，测量平均心率、搏动节律与心率变异，完成后自动生成报告。</view>
      <button class="app-button app-button--primary action-button" bindtap="startActiveTest" loading="{{activeTestStarting}}">开始 60 秒检测</button>
      <view class="app-muted action-hint" wx:if="{{!isConnected}}">需先连接设备后开始。</view>

      <block wx:if="{{hasLatestReport}}">
        <view class="section-divider"></view>
        <view class="report-head">
          <view class="report-tag">{{latestReport.resultTag}}</view>
          <view class="app-muted">{{latestReport.startedAt}}{{latestReport.durationLabel ? ' · ' + latestReport.durationLabel : ''}}</view>
        </view>
        <view class="report-line">
          <text class="report-key">平均心率</text>
          <text class="report-val">{{latestReport.heartRate}}</text>
        </view>
        <view class="app-body" wx:if="{{latestReport.summary}}">{{latestReport.summary}}</view>
      </block>
      <view class="app-empty" wx:else>还没有检测记录。</view>
    </block>
  </view>
</view>
