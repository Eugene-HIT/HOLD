.home-page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at top right, rgba(223, 115, 69, 0.18), transparent 34%),
    radial-gradient(circle at left 20%, rgba(70, 130, 104, 0.18), transparent 28%),
    linear-gradient(180deg, #f5efe2 0%, #ebe2cf 100%);
}

.home-hero {
  padding: 34rpx 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #1f3328 0%, #2d4c3c 52%, #8a5a38 100%);
  color: #fbf3e6;
  box-shadow: 0 24rpx 60rpx rgba(34, 43, 31, 0.16);
}

.hero-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(251, 243, 230, 0.16);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 12rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(251, 243, 230, 0.84);
}

.debug-entry {
  height: fit-content;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(251, 243, 230, 0.14);
  font-size: 22rpx;
  flex-shrink: 0;
}

.hero-metrics,
.analysis-grid,
.summary-strip,
.double-actions,
.hero-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.hero-metrics {
  margin-top: 28rpx;
}

.hero-actions {
  margin-top: 22rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.hero-actions .hero-ghost,
.hero-actions .hero-guide {
  min-width: 0;
  white-space: normal;
  line-height: 1.4;
}

.hero-chip {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.08);
}

.chip-label {
  display: block;
  font-size: 22rpx;
  color: rgba(251, 243, 230, 0.74);
}

.chip-value {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.hero-primary,
.hero-secondary,
.hero-ghost,
.hero-guide,
.solid-button,
.outline-button {
  border-radius: 18rpx;
  font-size: 28rpx;
}

.hero-primary,
.solid-button {
  background: #20372a;
  color: #f7f1df;
}

.hero-secondary,
.outline-button {
  background: transparent;
  color: #20372a;
  border: 2rpx solid rgba(32, 55, 42, 0.16);
}

.hero-ghost {
  background: rgba(255, 252, 246, 0.92);
  color: #20372a;
}

.hero-guide {
  background: linear-gradient(135deg, #6b4da6 0%, #8d63d1 100%);
  color: #fbf6ff;
}

.module-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 251, 244, 0.94);
  box-shadow: 0 18rpx 48rpx rgba(50, 52, 35, 0.08);
}

.calibration-card {
  background: linear-gradient(180deg, rgba(255, 244, 224, 0.98) 0%, rgba(255, 252, 246, 0.98) 100%);
}

.highlight-card {
  background: linear-gradient(180deg, rgba(255, 248, 237, 0.98) 0%, rgba(255, 252, 246, 0.98) 100%);
}

.analysis-card {
  background: linear-gradient(180deg, rgba(244, 250, 246, 0.98) 0%, rgba(255, 253, 248, 0.98) 100%);
}

.module-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.module-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2dc;
  color: #3d4f37;
  font-size: 20rpx;
  font-weight: 700;
}

.module-tag.warning {
  background: #f3d68c;
  color: #5c3818;
}

.module-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #20372a;
}

.module-action {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #20372a;
  color: #f8f2e3;
  font-size: 22rpx;
}

.calibration-state {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #7a441f;
}

.calibration-guide {
  margin-top: 16rpx;
  font-size: 48rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #20372a;
}

.calibration-phase {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #53614f;
}

.calibration-meta,
.calibration-extra-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.meta-pill,
.calibration-extra {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(32, 55, 42, 0.08);
  color: #3a4a39;
  font-size: 22rpx;
}

.analysis-stat {
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
}

.analysis-stat.breathing {
  background: #edf6f0;
}

.analysis-stat.heartbeat {
  background: #fff0e7;
}

.analysis-stat.stability {
  background: #f3efe5;
}

.analysis-number {
  font-size: 42rpx;
  font-weight: 700;
  color: #20372a;
}

.analysis-unit,
.analysis-label {
  display: block;
}

.analysis-unit {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6d7368;
}

.analysis-label {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #546257;
}

.summary-strip {
  margin-top: 24rpx;
}

.summary-pill {
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f1ead8;
}

.summary-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #20372a;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6d7368;
}

.data-list {
  margin-top: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  overflow: hidden;
}

.data-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid rgba(32, 55, 42, 0.08);
}

.data-row:last-child {
  border-bottom: none;
}

.data-label {
  color: #667064;
  font-size: 24rpx;
}

.data-value {
  color: #20372a;
  font-size: 24rpx;
  text-align: right;
}

.module-copy,
.empty-copy {
  margin-top: 22rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #304033;
}

.subtle-copy {
  color: #6d7368;
  font-size: 22rpx;
}

.empty-copy {
  color: #6d7368;
}

.double-actions {
  margin-top: 24rpx;
  grid-template-columns: 1fr 1fr;
}

.chart-panel-lite {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f7f1e4;
}

.mini-chart-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #20372a;
}

.mini-wave-canvas {
  margin-top: 16rpx;
  width: 100%;
  border-radius: 18rpx;
  background: #f8f3e7;
}

@media (max-width: 640rpx) {
  .hero-metrics,
  .analysis-grid,
  .summary-strip,
  .double-actions,
  .hero-actions {
    grid-template-columns: 1fr;
  }
}