.home-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
}

/* ---------- 顶部 ---------- */

.home-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 4rpx 28rpx;
}

.brand {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: #1b2419;
  line-height: 1.2;
}

.brand-sub {
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.debug-entry {
  font-size: 23rpx;
  color: #a8a89c;
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(27, 36, 25, 0.1);
  border-radius: 999rpx;
}

.debug-entry:active {
  color: #5d6558;
}

/* ---------- 设备卡 ---------- */

.device-card {
  padding: 26rpx 28rpx;
}

.device-row {
  display: flex;
  align-items: center;
}

.device-text {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.device-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1b2419;
  line-height: 1.4;
}

.connect-btn {
  flex: none;
  margin: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  background: #2f5d3a;
  color: #fffdf7;
}

.connect-btn.button-hover {
  background: #26492e;
}

/* ---------- 实时卡 ---------- */

.live-grid {
  display: flex;
  align-items: center;
  padding: 8rpx 0 24rpx;
}

.live-item {
  flex: 1;
  text-align: center;
}

.live-value {
  font-size: 64rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.1;
  letter-spacing: -2rpx;
}

.live-unit {
  font-size: 22rpx;
  color: #9a9a8e;
  margin-left: 8rpx;
  letter-spacing: 0;
}

.live-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(27, 36, 25, 0.08);
}

.wave-wrap {
  border-top: 1rpx solid rgba(27, 36, 25, 0.06);
  padding-top: 20rpx;
}

.wave-block + .wave-block {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(27, 36, 25, 0.05);
}

.wave-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.wave-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.wave-dot--resp {
  background: #3e7c59;
}

.wave-dot--heart {
  background: #b0583a;
}

.home-wave {
  width: 100%;
  height: 110rpx;
}

/* ---------- 引导卡 ---------- */

.guide-card {
  background: #efe7d6;
  border-color: rgba(47, 93, 58, 0.12);
}

.guide-text {
  font-size: 40rpx;
  line-height: 1.5;
  color: #1b2419;
  margin: 12rpx 0 8rpx;
  font-weight: 500;
}

/* ---------- 行动卡 ---------- */

.action-card .app-section-title {
  display: block;
  margin-bottom: 12rpx;
}

.action-button {
  margin-top: 28rpx;
}

.action-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
}

/* ---------- 指部 PPG 主动检测 ---------- */

.progress-row {
  margin: 4rpx 0 28rpx;
}

.progress-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(27, 36, 25, 0.08);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #3e7c59;
  transition: width 0.4s ease;
}

.progress-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.active-live {
  display: flex;
  margin-bottom: 24rpx;
}

.active-live-item {
  flex: 1;
  text-align: center;
}

.active-live-value {
  font-size: 46rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.2;
}

.active-live-item .app-metric-label {
  font-size: 21rpx;
}

.section-divider {
  height: 1rpx;
  background: rgba(27, 36, 25, 0.06);
  margin: 28rpx 0 24rpx;
}

/* ---------- 最近检测 ---------- */

.report-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.report-tag {
  font-size: 24rpx;
  color: #2f5d3a;
  background: rgba(47, 93, 58, 0.09);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.report-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 10rpx 0;
}

.report-key {
  font-size: 26rpx;
  color: #7d8578;
}

.report-val {
  font-size: 30rpx;
  color: #1b2419;
}

/* ---------- 快捷入口 ---------- */

.entry-row {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.entry-item {
  flex: 1;
  background: #fffdf7;
  border: 1rpx solid rgba(27, 36, 25, 0.06);
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
}

.entry-item:active {
  background: #f9f5ea;
}

.entry-title {
  font-size: 29rpx;
  font-weight: 500;
  color: #1b2419;
  margin-bottom: 6rpx;
}
