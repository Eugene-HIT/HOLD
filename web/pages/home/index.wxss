.home-page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at 16% 8%, rgba(255, 184, 155, 0.30), transparent 34%),
    radial-gradient(circle at 86% 18%, rgba(203, 185, 255, 0.26), transparent 36%),
    radial-gradient(circle at 52% 42%, rgba(255, 218, 229, 0.22), transparent 38%),
    #fffdfb;
  box-sizing: border-box;
}

.home-hero,
.module-card {
  box-sizing: border-box;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(120, 96, 110, 0.10);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 16rpx 42rpx rgba(150, 116, 132, 0.08);
}

.home-hero {
  margin-top: 0;
  background:
    radial-gradient(circle at 10% 12%, rgba(255, 199, 168, 0.34), transparent 34%),
    radial-gradient(circle at 84% 18%, rgba(203, 185, 255, 0.30), transparent 36%),
    rgba(255, 255, 255, 0.80);
}

.hero-title {
  color: #2d2a2a;
  font-size: 46rpx;
  font-weight: 800;
}

.hero-subtitle,
.guide-hint,
.label,
.analysis-label,
.analysis-unit {
  color: #6f6268;
  font-size: 25rpx;
  line-height: 1.6;
}

.hero-subtitle {
  margin-top: 12rpx;
}

.hero-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.solid-button,
.ghost-button,
.soft-button,
.accent-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  max-width: 100%;
  width: 100%;
  margin: 0;
  min-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.25;
  overflow: hidden;
  text-align: center;
  white-space: normal;
  word-break: keep-all;
}

.solid-button::after,
.ghost-button::after,
.soft-button::after,
.accent-button::after {
  border: 0;
}

.solid-button[disabled],
.ghost-button[disabled],
.soft-button[disabled],
.accent-button[disabled] {
  background: rgba(255, 255, 255, 0.62);
  color: #675c66;
  opacity: 1;
}

.solid-button,
.accent-button {
  background: linear-gradient(135deg, #ef8c72 0%, #a991f4 100%);
  color: #fffefa;
}

.ghost-button,
.soft-button {
  background: rgba(255, 255, 255, 0.78);
  color: #7c5f74;
}

.wide {
  margin-top: 24rpx;
  width: 100%;
}

.status-grid,
.analysis-grid {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.status-grid {
  grid-template-columns: 1fr;
}

.analysis-grid {
  grid-template-columns: repeat(2, 1fr);
}

.hero-chip,
.analysis-stat {
  box-sizing: border-box;
  max-width: 100%;
  min-width: 0;
  min-height: 112rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.58);
  overflow: hidden;
}

.chip-label,
.module-tag {
  display: block;
  color: #6f6268;
  font-size: 23rpx;
  font-weight: 700;
}

.chip-value,
.module-title,
.guide-copy,
.analysis-number,
.value {
  color: #2d2a2a;
  font-weight: 800;
}

.chip-value {
  margin-top: 10rpx;
  font-size: 29rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.module-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.module-header > view:first-child {
  min-width: 0;
}

.module-tag.warm {
  color: #8a6a31;
}

.module-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  line-height: 1.25;
}

.module-action {
  flex-shrink: 0;
  max-width: 180rpx;
  color: #7c5f74;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
  white-space: normal;
}

.guide-copy {
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.35;
}

.guide-hint {
  margin-top: 12rpx;
}

.mode-panel {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 12rpx 18rpx;
  align-items: center;
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 247, 251, 0.76);
}

.mode-label,
.mode-status {
  color: #6f6268;
  font-size: 24rpx;
  line-height: 1.4;
}

.mode-picker {
  min-width: 0;
  color: #2d2a2a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.mode-status {
  grid-column: 1 / -1;
}

.analysis-stat.breathing {
  background: linear-gradient(145deg, rgba(255, 232, 220, 0.76), rgba(255, 255, 255, 0.62));
}

.analysis-stat.heartbeat {
  background: linear-gradient(145deg, rgba(239, 231, 255, 0.78), rgba(255, 255, 255, 0.62));
}

.analysis-stat.stability,
.analysis-stat.neutral {
  background: linear-gradient(145deg, rgba(255, 245, 249, 0.78), rgba(255, 255, 255, 0.60));
}

.analysis-number {
  display: block;
  min-height: 52rpx;
  font-size: 38rpx;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.analysis-number.small {
  font-size: 25rpx;
  line-height: 1.45;
}

.analysis-unit,
.analysis-label {
  display: block;
  margin-top: 8rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(70, 92, 74, 0.10);
}

.label {
  flex-shrink: 0;
  max-width: 220rpx;
}

.value {
  min-width: 0;
  flex: 1;
  max-width: none;
  font-size: 25rpx;
  text-align: right;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.raw-block {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(240, 246, 244, 0.72);
  color: #405145;
  font-size: 22rpx;
  line-height: 1.6;
  word-break: break-all;
}

.raw-block.subdued {
  background: rgba(245, 240, 246, 0.72);
  color: #7a7468;
}

@media (max-width: 640rpx) {
  .hero-actions,
  .analysis-grid {
    grid-template-columns: 1fr;
  }
}
