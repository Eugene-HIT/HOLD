<view class="page">
  <view class="hero">
    <view class="hero-tag">DEBUG</view>
    <view class="hero-title">BLE 调试联调台</view>
    <view class="hero-subtitle">保留扫描、连接、订阅能力，并把最新呼吸曲线、心率曲线、bpm、状态文本和错误信息集中在一个页面里看。</view>
  </view>

  <view class="panel status-panel">
    <view class="panel-title">链路状态</view>
    <view class="status-row"><text class="label">适配器</text><text class="value">{{adapterStatus}}</text></view>
    <view class="status-row"><text class="label">连接</text><text class="value">{{connectionStatus}}</text></view>
    <view class="status-row"><text class="label">设备</text><text class="value">{{deviceName}}</text></view>
    <view class="status-row"><text class="label">设备状态</text><text class="value">{{currentDeviceState}}</text></view>
    <view class="status-row"><text class="label">最近包类型</text><text class="value">{{lastPacketType}}</text></view>
    <view class="status-row"><text class="label">当前引导</text><text class="value">{{currentGuideText}}</text></view>
  </view>

  <view class="actions">
    <button class="primary" bindtap="handleScanAndConnect" loading="{{scanning}}">扫描并连接</button>
    <button class="secondary" bindtap="disconnectDevice">断开连接</button>
    <button class="ghost" bindtap="clearDebugPanels">清空调试窗口</button>
  </view>

  <view class="panel">
    <view class="panel-title">实时指标</view>
    <view class="metric-grid">
      <view class="metric-card">
        <text class="metric-value">{{currentRespBpm}}</text>
        <text class="metric-label">呼吸 bpm</text>
      </view>
      <view class="metric-card">
        <text class="metric-value">{{currentHeartBpm}}</text>
        <text class="metric-label">心率 bpm</text>
      </view>
      <view class="metric-card">
        <text class="metric-value small">{{currentMotionLevel}}</text>
        <text class="metric-label">motion</text>
      </view>
      <view class="metric-card">
        <text class="metric-value">{{currentBeatCount}}</text>
        <text class="metric-label">beat count</text>
      </view>
      <view class="metric-card">
        <text class="metric-value small">{{currentPhaseText}}</text>
        <text class="metric-label">phase / axis</text>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">呼吸曲线窗口</view>
    <view class="chart-caption">{{respWaveSummary}}</view>
    <canvas canvas-id="respWaveCanvas" class="wave-canvas" style="width: {{chartWidth}}px; height: {{chartHeight}}px;" width="{{chartWidth}}" height="{{chartHeight}}"></canvas>
  </view>

  <view class="panel">
    <view class="panel-title">心率曲线窗口（I6 / I7）</view>
    <view class="chart-caption">{{heartWaveSummary}}</view>
    <canvas canvas-id="heartWaveCanvas" class="wave-canvas" style="width: {{chartWidth}}px; height: {{chartHeight}}px;" width="{{chartWidth}}" height="{{chartHeight}}"></canvas>
  </view>

  <view class="panel">
    <view class="panel-title">调试日志 / 报错窗口</view>
    <view class="log-list">
      <view class="log-item" wx:for="{{debugLogs}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">最近原始消息</view>
    <view class="status-row"><text class="label">最近时间</text><text class="value">{{lastEventTime}}</text></view>
    <view class="raw-block">{{lastEventRaw}}</view>
  </view>

  <view class="panel tip-panel">
    <view class="panel-title">调试提示</view>
    <view class="tip-text">当前页面只接收真实整机 BLE 调试消息。未连接、未订阅或设备未上报时，各指标和波形窗口保持空白。</view>
  </view>
</view>