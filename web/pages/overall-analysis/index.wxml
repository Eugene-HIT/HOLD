<view class="overall-page">
  <view class="page-topbar">
    <view class="app-title">整体分析</view>
  </view>

  <view class="group-label">今日</view>

  <view class="app-card">
    <view class="app-card-head">
      <view class="app-section-title">今日概览</view>
      <text class="app-card-head__link" bindtap="openDailyAnalysis">每日分析详情</text>
    </view>

    <view class="overview-grid" wx:if="{{hasToday}}">
      <view class="overview-item">
        <view class="overview-value">{{todayResp}}</view>
        <view class="app-metric-label">平均呼吸（次/分）</view>
      </view>
      <view class="overview-item">
        <view class="overview-value">{{todayHeart}}</view>
        <view class="app-metric-label">平均心率（bpm）</view>
      </view>
      <view class="overview-item">
        <view class="overview-value">{{todayWindows}}</view>
        <view class="app-metric-label">监测窗口（个）</view>
      </view>
    </view>
    <view class="app-body" wx:if="{{hasToday && todaySummary}}">{{todaySummary}}</view>
    <view class="app-empty" wx:if="{{!hasToday}}">今天还没有监测数据，连接设备后会自动记录。</view>
  </view>

  <view class="group-label">整体趋势</view>

  <view class="app-card trend-card">
    <view class="app-eyebrow">当前状态</view>
    <view class="status-text">{{overallSummary.summary || '暂无整体摘要，连接设备并记录一段时间数据后自动生成。'}}</view>

    <view class="advice-block" wx:if="{{overallSummary.advice}}">
      <view class="advice-label">建议</view>
      <view class="advice-body">{{overallSummary.advice}}</view>
    </view>

    <view class="trend-section" wx:for="{{sections}}" wx:for-item="section" wx:key="key">
      <view class="section-head">
        <view class="section-dot {{section.key}}"></view>
        <view class="app-section-title">{{section.title}}</view>
      </view>
      <view class="app-body">{{section.body}}</view>
    </view>

    <view class="trend-foot">
      <button class="app-button app-button--outline refresh-button" bindtap="refreshInsight" loading="{{insightStatus === 'running'}}">
        {{insightStatus === 'running' ? '正在更新' : '刷新分析'}}
      </button>
      <view class="app-muted trend-updated">{{overallSummary.updatedAt ? '更新于 ' + overallSummary.updatedAt : '尚未生成分析'}}</view>
    </view>
  </view>
</view>
