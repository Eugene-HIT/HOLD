.overall-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
}

.page-topbar {
  padding: 12rpx 4rpx 28rpx;
}

.page-topbar .app-title {
  display: block;
  margin-bottom: 8rpx;
}

/* ---------- 功能分组 ---------- */

.group-label {
  font-size: 23rpx;
  color: #9a9a8e;
  letter-spacing: 2rpx;
  padding: 8rpx 4rpx 14rpx;
}

/* ---------- 今日概览 ---------- */

.overview-grid {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 0 20rpx;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-value {
  font-size: 44rpx;
  font-weight: 300;
  color: #1b2419;
  line-height: 1.2;
}

.overview-item .app-metric-label {
  font-size: 21rpx;
}

/* ---------- 整体趋势一体卡 ---------- */

.trend-card .app-eyebrow {
  display: block;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 30rpx;
  line-height: 1.75;
  color: #1b2419;
}

.advice-block {
  margin-top: 20rpx;
  background: #f6f2e8;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
}

.advice-label {
  font-size: 22rpx;
  color: #9a9a8e;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.advice-body {
  font-size: 26rpx;
  line-height: 1.7;
  color: #4a5346;
}

.trend-section {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(27, 36, 25, 0.06);
}

.trend-foot {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(27, 36, 25, 0.06);
}

.trend-updated {
  display: block;
  margin-top: 14rpx;
  text-align: center;
}

.refresh-button {
  margin-top: 0;
}

/* ---------- 结果板块 ---------- */

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex: none;
  background: #c3c3b6;
}

.section-dot.resp {
  background: #3e7c59;
}

.section-dot.heart {
  background: #b4472f;
}
