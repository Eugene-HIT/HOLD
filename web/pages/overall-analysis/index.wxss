.overall-page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #f4ede2 0%, #e9dfcd 100%);
}

.overall-hero,
.overall-panel {
  border-radius: 28rpx;
  background: rgba(255, 252, 246, 0.95);
  box-shadow: 0 18rpx 46rpx rgba(50, 52, 35, 0.08);
}

.overall-hero {
  padding: 30rpx;
  background: linear-gradient(135deg, #21382c 0%, #315244 100%);
  color: #faf2e6;
}

.hero-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(250, 242, 230, 0.12);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(250, 242, 230, 0.84);
}

.overall-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
}

.panel-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #20372a;
}

.panel-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #697364;
}

.refresh-button {
  border-radius: 18rpx;
  background: #20372a;
  color: #f7f1df;
  font-size: 24rpx;
}

.ghost-button {
  border-radius: 18rpx;
  background: #efe6d4;
  color: #20372a;
  font-size: 24rpx;
}

.section-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #4f5e4e;
}

.report-error {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b15435;
}
